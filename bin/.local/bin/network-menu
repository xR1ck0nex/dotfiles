#!/usr/bin/env zsh
# ~/.local/bin/network-menu - NetworkManager menu for hyprlauncher
#
# Glossary
#   profile  a saved NetworkManager connection, keyed by UUID
#   link     a profile that carries traffic itself (wifi, ethernet, ...)
#   vpn      a profile layered on a link (wireguard, vpn)
#   primary  the first active link; "disconnect" and "details" act on it
#   network  a Wi-Fi network seen in a scan, keyed by SSID
#   action   what choosing a menu line does, e.g. "vpn:<uuid>"
#   label    a menu line: "<icon>  <text>  <status icon>"
#
# Needs: nmcli, hyprlauncher, foot. Optional: notify-send, wl-copy, qrencode.
# Icons: a Nerd Font >= 3.0 (nf-md-* glyphs); NETWORK_MENU_ICONS=plain
# switches to text markers for systems without one.

set -uo pipefail
setopt extended_glob

# ---- settings -------------------------------------------------------------
MENU=(hyprlauncher --dmenu)
TERMINAL=(foot -a network-menu)   # app-id for a Hyprland float rule
HOLD=(-H)                         # keep the terminal open after the command
HOTSPOT_NAME=Hotspot
PORTAL_URL=http://neverssl.com
SCAN_LIMIT=15
ICONS=${NETWORK_MENU_ICONS:-nerd}

SELF=${ZSH_ARGZERO:A}

# ---- icons ----------------------------------------------------------------
# One table per style; every label takes its icons from I[...].
typeset -A I
typeset -a SIGNAL_OPEN SIGNAL_LOCK   # 0..4 bars
if [[ $ICONS == nerd ]]; then
	I=(
		details   $'\U000f02fd'   # md-information_outline
		wifi      $'\U000f05a9'   # md-wifi
		ethernet  $'\U000f0200'   # md-ethernet
		other     $'\U000f0317'   # md-lan
		vpn_on    $'\U000f099d'   # md-shield_lock
		vpn_off   $'\U000f099c'   # md-shield_off_outline
		on        $'\U000f0521'   # md-toggle_switch
		off       $'\U000f0a19'   # md-toggle_switch_off_outline
		active    $'\U000f012c'   # md-check
		saved     $'\U000f0193'   # md-content_save
		rescan    $'\U000f0450'   # md-refresh
		hidden    $'\U000f05f9'   # md-incognito
		wifi_on   $'\U000f05a9'   # md-wifi
		wifi_off  $'\U000f05aa'   # md-wifi_off
		plane_on  $'\U000f001d'   # md-airplane
		plane_off $'\U000f001e'   # md-airplane_off
		ap_on     $'\U000f0003'   # md-access_point
		ap_off    $'\U000f1511'   # md-access_point_off
		disconnect $'\U000f0319'  # md-lan_disconnect
		connect   $'\U000f0318'   # md-lan_connect
		edit      $'\U000f0493'   # md-cog
		autoconn  $'\U000f006a'   # md-autorenew
		qr        $'\U000f0432'   # md-qrcode
		forget    $'\U000f01b4'   # md-delete
		no        $'\U000f0156'   # md-close
		back      $'\U000f004d'   # md-arrow_left
		online    $'\U000f01e7'   # md-earth
		offline   $'\U000f01e8'   # md-earth_off
		portal    $'\U000f059f'   # md-web
		mac       $'\U000f0efe'   # md-identifier
		ipv4      $'\U000f0a5f'   # md-ip
		ipv6      $'\U000f0a60'   # md-ip_network
		gateway   $'\U000f1087'   # md-router_network
		dns       $'\U000f01d6'   # md-dns
		ping      $'\U000f04c5'   # md-speedometer
	)
	# md-wifi_strength_{outline,1,2,3,4} and md-wifi_strength_{lock_outline,N_lock}
	SIGNAL_OPEN=($'\U000f092f' $'\U000f091f' $'\U000f0922' $'\U000f0925' $'\U000f0928')
	SIGNAL_LOCK=($'\U000f092c' $'\U000f0921' $'\U000f0924' $'\U000f0927' $'\U000f092a')
else
	# plain: kinds and states as text, actions without icons, nmcli BARS for signal
	I=(wifi '[wifi]' ethernet '[eth]' vpn_on '[vpn]' vpn_off '[vpn]'
		on '[on]' off '[off]' active '*' saved '+')
fi
icon() { REPLY=; [[ -n ${1-} ]] && REPLY=${I[$1]-}; return 0 }

# ---- state, parsed once from nmcli ----------------------------------------
typeset -a order            # profile UUIDs in nmcli order
typeset -A kind name active device ssid   # by UUID
typeset -A saved_ssid       # SSID -> UUID of the profile for it
typeset -A net_sec          # SSID -> security as seen in the scan
primary= hotspot=
typeset -a lines            # current menu, in order
typeset -A act              # trimmed menu line -> action

# ---- helpers --------------------------------------------------------------
# notify <message> [freedesktop icon name]
notify() {
	(( $+commands[notify-send] )) \
		&& notify-send -a network-menu -i ${2:-network-transmit-receive} "Network" "$1"
	return 0
}

# nmcli terse output escapes ':' and '\' with '\'; undo that for one value
unesc() { REPLY=${1//(#b)\\(?)/${match[1]}} }

trim() { REPLY=${${1##[[:space:]]#}%%[[:space:]]#} }

# show lines in the launcher, print the chosen one; non-zero on Esc
menu() { print -rl -- "$@" | "${MENU[@]}" }

# label <icon key> <text> [status icon key]
label() {
	local lead tail
	icon $1; lead=$REPLY
	icon ${3-}; tail=$REPLY
	REPLY="${lead:+$lead  }$2${tail:+  $tail}"
}

# add <action> <icon key> <text> [status icon key]
# repeated labels (NM allows duplicate names) get " #2", " #3"...
add() {
	local text
	integer n=1
	label $2 $3 ${4-}; text=$REPLY
	trim "$text"
	while (( ${+act[$REPLY]} )); do
		trim "$text #$(( ++n ))"
	done
	lines+=("$REPLY")
	act[$REPLY]=$1
}

# start a submenu: title line (does nothing) + back entry at the end
submenu() {
	lines=() act=()
	add none $1 $2
}

choose() {
	local choice
	choice=$(menu $lines) || return 1
	trim "$choice"
	[[ -n $REPLY && -n ${act[$REPLY]-} ]] || return 1
	dispatch ${act[$REPLY]}
}

confirm() {
	local no yes
	label no "No, keep it"; no=$REPLY
	label ${2:-forget} "Yes, $1"; yes=$REPLY
	[[ $(menu $no $yes) == $yes ]]
}

# run [-i icon] <success message> <command...>
# notify the message, or the error nmcli printed
run() {
	local icon= msg out
	[[ $1 == -i ]] && { icon=$2; shift 2 }
	msg=$1; shift
	if out=$("$@" 2>&1); then
		notify $msg $icon
		return 0
	fi
	notify "Failed: ${${out##*$'\n'}:-$*}" dialog-error
	return 1
}

# signal_icon <percent> <security> <nmcli bars>
signal_icon() {
	integer pct=${1:-0} lvl
	if [[ $ICONS != nerd ]]; then REPLY=$3; return; fi
	(( lvl = pct >= 80 ? 4 : pct >= 60 ? 3 : pct >= 40 ? 2 : pct >= 20 ? 1 : 0 ))
	if [[ $2 == open ]]; then REPLY=${SIGNAL_OPEN[lvl+1]}
	else REPLY=${SIGNAL_LOCK[lvl+1]}
	fi
}

# ---- parsing --------------------------------------------------------------
kind_of() {
	case $1 in
		802-11-wireless|wifi) REPLY=wifi ;;
		802-3-ethernet|ethernet) REPLY=ethernet ;;
		wireguard|vpn) REPLY=vpn ;;
		loopback) REPLY=skip ;;
		*) REPLY=$1 ;;
	esac
}

# icon key for a profile kind; unknown kinds show their name in plain mode
kind_icon() {
	if (( ${+I[$1]} )); then REPLY=$1
	elif [[ $ICONS == nerd ]]; then REPLY=other
	else I[k_$1]="[$1]"; REPLY=k_$1
	fi
}

load_profiles() {
	local uuid type on dev text
	while IFS=: read -r uuid type on dev text; do
		kind_of $type
		[[ $REPLY == skip ]] && continue
		order+=($uuid)
		kind[$uuid]=$REPLY
		active[$uuid]=$on
		device[$uuid]=$dev
		unesc "$text"; name[$uuid]=$REPLY
	done < <(nmcli -t -f UUID,TYPE,ACTIVE,DEVICE,NAME connection show)

	for uuid in $order; do
		[[ ${kind[$uuid]} == wifi ]] || continue
		unesc "$(nmcli -g 802-11-wireless.ssid connection show uuid $uuid)"
		ssid[$uuid]=$REPLY
		saved_ssid[$REPLY]=$uuid
		[[ ${name[$uuid]} == $HOTSPOT_NAME ]] && hotspot=$uuid
	done

	for uuid in $order; do
		[[ ${active[$uuid]} == yes && ${kind[$uuid]} != vpn && $uuid != $hotspot ]] || continue
		primary=$uuid
		break
	done
}

has_wifi() { [[ -n ${(M)${(f)"$(nmcli -t -f TYPE device status)"}:#wifi} ]] }

# ---- main menu ------------------------------------------------------------
build_main() {
	local u
	[[ -n $primary ]] && add details details "Details · ${name[$primary]} on ${device[$primary]}"

	for u in $order; do
		[[ ${kind[$u]} == vpn ]] && continue
		kind_icon ${kind[$u]}
		add profile:$u $REPLY ${name[$u]} ${${${active[$u]}:#no}:+active}
	done

	for u in $order; do
		[[ ${kind[$u]} == vpn ]] || continue
		if [[ ${active[$u]} == yes ]]; then add vpn:$u vpn_on ${name[$u]} on
		else add vpn:$u vpn_off ${name[$u]} off
		fi
	done

	has_wifi && build_wifi

	[[ -n $primary ]] && add down:$primary disconnect "Disconnect ${name[$primary]}"
	add edit edit "Edit connections"
}

build_wifi() {
	local wifi wwan
	IFS=: read -r _ wifi _ wwan <<< "$(nmcli -t radio all)"

	if [[ $wifi == enabled ]]; then
		build_scan
		add rescan rescan "Rescan Wi-Fi"
		add hidden hidden "Connect to hidden network"
		add radio:off wifi_off "Turn Wi-Fi off"
	else
		add radio:on wifi_on "Turn Wi-Fi on"
	fi

	if [[ $wifi == disabled && $wwan == disabled ]]; then
		add airplane:off plane_off "Turn airplane mode off"
	else
		add airplane:on plane_on "Turn airplane mode on"
	fi

	if [[ -n $hotspot && ${active[$hotspot]} == yes ]]; then
		add down:$hotspot ap_off "Stop hotspot"
	elif [[ $wifi == enabled ]]; then
		add hotspot ap_on "Start hotspot"
	fi
}

build_scan() {
	local inuse signal bars sec net mark
	integer shown=0
	local -A seen
	while IFS=: read -r inuse signal bars sec net; do
		unesc "$net"; net=$REPLY
		[[ -z $net || $net == -- || -n ${seen[$net]-} ]] && continue
		seen[$net]=1
		(( shown++ < SCAN_LIMIT )) || break
		[[ $sec == (|--) ]] && sec=open
		net_sec[$net]=$sec
		if [[ -n $primary && $net == ${ssid[$primary]-} ]]; then mark=active
		elif [[ -n ${saved_ssid[$net]-} ]]; then mark=saved
		else mark=
		fi
		signal_icon $signal $sec $bars
		I[_sig]=$REPLY
		add ssid:$net _sig "$net · $signal% · $sec" $mark
	done < <(nmcli -t -f IN-USE,SIGNAL,BARS,SECURITY,SSID device wifi list | sort -t: -k2,2 -rn)
}

# ---- actions --------------------------------------------------------------
dispatch() {
	local arg=${1#*:}
	case $1 in
		details)     details_menu ;;
		profile:*)   profile_menu $arg ;;
		vpn:*)       toggle $arg ;;
		up:*)        run "Connected to ${name[$arg]}" nmcli connection up uuid $arg ;;
		down:*)      run -i network-offline "Disconnected ${name[$arg]}" nmcli connection down uuid $arg ;;
		autoconnect:*) set_autoconnect ${arg%%:*} ${arg#*:} ;;
		forget:*)    confirm "forget ${name[$arg]}" && run -i edit-delete "Forgot ${name[$arg]}" nmcli connection delete uuid $arg ;;
		qr:*)        share_qr $arg ;;
		ssid:*)      connect_ssid $arg ;;
		hidden)      ask_connect "" hidden yes ;;
		rescan)      notify "Scanning..." view-refresh; nmcli device wifi list --rescan yes > /dev/null; exec $SELF ;;
		back)        exec $SELF ;;
		radio:on)    run "Wi-Fi on" nmcli radio wifi on ;;
		radio:off)   run -i network-offline "Wi-Fi off" nmcli radio wifi off ;;
		airplane:on)  run -i airplane-mode "Airplane mode on" nmcli radio all off ;;
		airplane:off) run "Airplane mode off" nmcli radio all on ;;
		hotspot)     start_hotspot ;;
		copy:*)      print -rn -- $arg | wl-copy && notify "Copied $arg" edit-copy ;;
		ping:*)      ping_host $arg ;;
		portal)      xdg-open $PORTAL_URL &! ;;
		edit)        "${TERMINAL[@]}" -T "Network connections" nmtui ;;
	esac
}

toggle() {
	if [[ ${active[$1]} == yes ]]; then dispatch down:$1
	else dispatch up:$1
	fi
}

profile_menu() {
	local u=$1
	kind_icon ${kind[$u]}
	submenu $REPLY ${name[$u]}
	if [[ ${active[$u]} == yes ]]; then add down:$u disconnect Disconnect
	else add up:$u connect Connect
	fi
	if [[ $(nmcli -g connection.autoconnect connection show uuid $u) == yes ]]; then
		add autoconnect:$u:no autoconn Autoconnect on
	else
		add autoconnect:$u:yes autoconn Autoconnect off
	fi
	[[ ${kind[$u]} == wifi ]] && add qr:$u qr "Share as QR code"
	add forget:$u forget Forget
	add back back Back
	choose
}

set_autoconnect() {
	run "Autoconnect for ${name[$1]}: $2" nmcli connection modify uuid $1 connection.autoconnect $2
}

connect_ssid() {
	local net=$1
	if [[ -n ${saved_ssid[$net]-} ]]; then
		dispatch up:${saved_ssid[$net]}
		return
	fi
	case ${net_sec[$net]} in
		open)      run "Connected to $net" nmcli device wifi connect $net ;;
		*802.1X*)  "${TERMINAL[@]}" -T "Connect to $net" nmtui connect ;;   # enterprise: identity + certs
		*)         ask_connect $net ;;
	esac
}

# Connect in a terminal so nmcli can prompt for the secret itself: the
# password is typed hidden and never appears on any command line.
ask_connect() {
	local title=${1:-hidden network}
	icon wifi
	"${TERMINAL[@]}" -T "Connect to $title" zsh -c '
		icon=$1 net=$2; shift 2
		print -P "%B${icon:+$icon  }Connect to ${net:-a hidden network}%b\n"
		[[ -z $net ]] && read -r "net?Network name: "
		[[ -z $net ]] && exit 0
		if nmcli --ask device wifi connect "$net" "$@"; then
			notify-send -a network-menu -i network-wireless Network "Connected to $net"
		else
			notify-send -a network-menu -i dialog-error Network "Failed to connect to $net"
			print; read -rsk1 "?Press any key to close"
		fi
	' network-menu "$REPLY" "$@"
}

# WIFI:T:<type>;S:<ssid>;P:<psk>;; with \ ; , : " escaped
qr_escape() { REPLY=${1//(#b)([\\;,:\"])/\\${match[1]}} }

share_qr() {
	local u=$1 mgmt type net psk= payload tmp
	(( $+commands[qrencode] )) || { notify "Install qrencode to share networks as QR codes" dialog-error; return 1 }
	mgmt=$(nmcli -g 802-11-wireless-security.key-mgmt connection show uuid $u)
	case $mgmt in
		'')      type=nopass ;;
		wpa-psk) type=WPA ;;
		sae)     type=SAE ;;   # WPA3
		*) notify "Can't share ${name[$u]} as QR ($mgmt)" dialog-error; return 1 ;;
	esac
	qr_escape "${ssid[$u]}"; net=$REPLY
	if [[ $type != nopass ]]; then
		unesc "$(nmcli -s -g 802-11-wireless-security.psk connection show uuid $u)"
		qr_escape "$REPLY"; psk="P:$REPLY;"
	fi
	payload="WIFI:T:$type;S:$net;$psk;"
	tmp=$(mktemp) || return 1
	icon qr
	print -r -- "  ${REPLY:+$REPLY  }Scan to join ${ssid[$u]}"$'\n' > $tmp
	print -rn -- $payload | qrencode -t ansiutf8 -o - >> $tmp
	"${TERMINAL[@]}" -T "Share ${name[$u]}" $HOLD cat $tmp
	rm -f $tmp
}

start_hotspot() {
	if [[ -n $primary && ${kind[$primary]} == wifi ]]; then
		confirm "start hotspot (drops ${name[$primary]})" ap_on || return 0
	fi
	"${TERMINAL[@]}" -T "Hotspot" $HOLD nmcli --show-secrets device wifi hotspot con-name $HOTSPOT_NAME
}

# ---- details --------------------------------------------------------------
details_menu() {
	local dev=${device[$primary]} key val conn gw
	conn=$(nmcli networking connectivity check)
	kind_icon ${kind[$primary]}
	submenu $REPLY ${name[$primary]}
	if [[ $conn == full ]]; then add none online "Connectivity · $conn"
	else add none offline "Connectivity · $conn"
	fi
	[[ $conn == (portal|limited) ]] && add portal portal "Open captive portal login"

	while IFS=: read -r key val; do
		unesc "$val"; val=$REPLY
		[[ -z $val || $val == -- ]] && continue
		case ${key%%\[*} in
			GENERAL.HWADDR) add copy:$val mac "MAC · $val" ;;
			IP4.ADDRESS)    add copy:${val%/*} ipv4 "IPv4 · $val" ;;
			IP4.GATEWAY)    add copy:$val gateway "Gateway · $val"; gw=$val ;;
			IP4.DNS)        add copy:$val dns "DNS · $val" ;;
			IP6.ADDRESS)    add copy:${val%/*} ipv6 "IPv6 · $val" ;;
			IP6.GATEWAY)    add copy:$val gateway "IPv6 gateway · $val" ;;
		esac
	done < <(nmcli -t -f GENERAL.HWADDR,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,IP6.ADDRESS,IP6.GATEWAY device show $dev)

	[[ ${kind[$primary]} == wifi ]] && wifi_line
	[[ -n ${gw-} ]] && add ping:$gw ping "Ping gateway"
	add back back Back
	choose
}

wifi_line() {
	local inuse chan freq rate signal bars sec net
	while IFS=: read -r inuse chan freq rate signal bars sec net; do
		[[ $inuse == '*' ]] || continue
		unesc "$net"; net=$REPLY
		[[ $sec == (|--) ]] && sec=open
		signal_icon $signal $sec $bars
		I[_sig]=$REPLY
		add none _sig "$net · channel $chan · $freq · $rate · $signal%"
		return
	done < <(nmcli -t -f IN-USE,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY,SSID device wifi list --rescan no)
}

ping_host() {
	local out
	notify "Pinging $1..." network-transmit-receive
	out=$(ping -c 3 -q $1 2>&1)
	notify "$1: ${(pj:\n:)${(@M)${(@f)out}:#*(packet loss|rtt)*}:-unreachable}"
}

# ---- main -----------------------------------------------------------------
main() {
	load_profiles
	build_main
	choose
	return 0
}

[[ $ZSH_EVAL_CONTEXT == toplevel ]] && main "$@"
