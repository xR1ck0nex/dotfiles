# ~/.config/mako/config

font=JetBrainsMono Nerd Font 11

background-color=#26233a
text-color=#e0def4
border-color=#524f67
border-size=2
border-radius=12

width=380
height=160
padding=14,18
margin=44,12,12,12

anchor=bottom-right
layer=overlay
max-visible=5
sort=-time
default-timeout=6000
history=1
max-history=20

icons=1
max-icon-size=48
icon-location=left

markup=1
actions=1
format=<b>%s</b>\n%b
text-alignment=left

group-by=app-name

progress-color=over #31748f

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=exec makoctl menu -n "$id" hyprlauncher --dmenu

[urgency=low]
border-color=#6e6a86
text-color=#908caa
default-timeout=4000

[urgency=normal]
border-color=#c4a7e7

[urgency=high]
border-color=#eb6f92

[urgency=critical]
border-color=#eb6f92
text-color=#eb6f92
default-timeout=0

[grouped]
format=<b>%s</b> (%g)\n%b

[mode=dnd]
invisible=1

